# Copy this file to .env and replace the example values.
# Never commit .env or paste its secrets into chat.
APP_ENV=development
DATABASE_URL=
SECRET_KEY=replace-with-a-long-random-secret
PUBLIC_BASE_URL=
PHOTO_RETENTION_DAYS=
UPLOAD_DIR=

# For Supabase SSL verification, set these in DATABASE_URL and PGSSLROOTCERT.
# Example DATABASE_URL shape:
# postgresql://postgres.<project-ref>:<url-encoded-password>@<session-pooler-host>:5432/postgres?sslmode=verify-full
PGSSLROOTCERT=

# Optional: required to enable email verification and password reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
